{{- $container_type := env "CHEZMOI_CONTAINER_TYPE" }}
[user]
{{- if eq $container_type "ai" }}
	name = dangertoaster
	email = 343128880+dangertoaster@users.noreply.github.com
	signingKey = ~/.ssh/dangertoaster_sign.pub
{{- else }}
	email = imani.pelton@canonical.com
	name = Imani Pelton
	signingKey = {{ .key_id }}
{{- end }}
{{- if eq $container_type "ai" }}

[gpg]
	format = ssh

# Route raw git's HTTPS auth through gh so GH_TOKEN covers fetch/push too
[credential "https://github.com"]
	helper = !gh auth git-credential
{{- end }}

[init]
	defaultBranch = main
[core]
	pager = delta
	editor = zed -w
	fsmonitor = true
	untrackedCache = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[commit]
	gpgsign = true
	verbose = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	autoSetupRemote = true
[help]
	autocorrect = prompt
[rerere]
	enabled = true
	autoupdate = true
[pull]
	rebase = true
[bash]
	showInformativeStatus = true
	showDirtyState = true
	showUntrackedFiles = true
